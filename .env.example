# ─────────────────────────────────────────────────────────────────────────────
# Meme'd — environment configuration
#
# Copy to `.env` (never commit it) and fill in the placeholders.
#   cp .env.example .env
#
# BACKEND-ONLY variables are read by the API process and must never be exposed
# to the browser. FRONTEND-PUBLIC variables (NEXT_PUBLIC_*) are inlined into the
# JavaScript bundle at build time — put nothing secret in them.
#
# The API validates every variable at startup and refuses to boot with a clear
# message if something essential is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application (backend-only) ───────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# API port
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── MongoDB (backend-only) ───────────────────────────────────────────────────
# Production: a MongoDB Atlas connection string. Must be a replica set or
# sharded cluster (all Atlas tiers are) because payouts use transactions.
# Local alternative: `docker compose --profile local-db up` and use
#   mongodb://mongo:27017/memed?replicaSet=rs0        (from inside compose)
#   mongodb://localhost:27017/memed?replicaSet=rs0&directConnection=true (from your machine)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/memed?retryWrites=true&w=majority
# optional; overrides the db in the URI
MONGODB_DB_NAME=memed
# connections per API instance
MONGODB_MAX_POOL_SIZE=20
# build indexes on boot (default: true in dev, false in prod — run `npm run db:init` on deploy instead)
DB_AUTO_INDEX=true

# ── Redis (backend-only) ─────────────────────────────────────────────────────
# Optional but recommended: discovery cache, distributed rate limits, job lock.
# If unset or down, the API keeps working (no cache, per-instance rate limits).
# ElastiCache in AWS: rediss://<primary-endpoint>:6379
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=memed:
REDIS_COMMAND_TIMEOUT_MS=250

# ── Auth (backend-only) ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<generate-a-random-secret-of-at-least-32-characters>
# 15-minute access tokens
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=memed-api
JWT_AUDIENCE=memed-web
# rotating refresh tokens, stored hashed
REFRESH_TOKEN_TTL_DAYS=14
# tolerance for two tabs refreshing at once
REFRESH_REUSE_GRACE_SECONDS=10
# then the account is locked for…
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Cookies & CORS (backend-only) ────────────────────────────────────────────
# MUST be true in production (HTTPS); defaults to true when NODE_ENV=production
COOKIE_SECURE=false
# lax | strict
COOKIE_SAMESITE=lax
# leave empty for host-only cookies
COOKIE_DOMAIN=
# comma-separated allow-list; required in production
CORS_ORIGINS=http://localhost:3000
# set to 1 behind the AWS ALB so client IPs are correct
TRUST_PROXY=0

# ── View updates: PATCH /api/submissions/:id/views (backend-only) ────────────
# internal   – callers must send X-Service-Key: <VIEW_UPDATE_SERVICE_KEY> (production default)
# simulation – no key needed; enables the in-app "Simulate views" control (local/demo only;
#              refused when NODE_ENV=production unless ALLOW_VIEW_SIMULATION_IN_PRODUCTION=true)
VIEW_UPDATE_MODE=simulation
VIEW_UPDATE_SERVICE_KEY=<generate-a-random-key-of-at-least-32-characters>
ALLOW_VIEW_SIMULATION_IN_PRODUCTION=false

# ── Rate limiting (backend-only) ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
# per IP per window, all /api routes
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# signup/login/refresh per IP per window
AUTH_RATE_LIMIT_MAX=30
# view updates per IP per minute
VIEW_UPDATE_RATE_LIMIT_MAX=120
# view updates per submission per minute
VIEW_UPDATE_PER_SUBMISSION_MAX=30

# ── Caching (backend-only) ───────────────────────────────────────────────────
CAMPAIGN_CACHE_TTL_SECONDS=30

# ── View-spike detector (backend-only) — a heuristic, flags never block payouts
# look-back window
VIEW_SPIKE_WINDOW_MINUTES=60
# ignore jumps smaller than this
VIEW_SPIKE_MIN_INCREASE=50000
# flag when the latest hourly rate is ≥ N× the post's own baseline
VIEW_SPIKE_RATE_MULTIPLIER=8
# snapshots needed before the rate rule applies
VIEW_SPIKE_MIN_HISTORY=3
# flag any gain this large inside the window, even without history
VIEW_SPIKE_ABSOLUTE_CEILING=1000000

# ── Payout engine & jobs (backend-only) ──────────────────────────────────────
# bounded retries for contended transactions
TRANSACTION_MAX_ATTEMPTS=10
# safety-net back-fill job; 0 disables
RECONCILIATION_INTERVAL_SECONDS=300
MAX_SUBMISSIONS_PER_CREATOR_PER_CAMPAIGN=10

# ── HTTP server (backend-only) ───────────────────────────────────────────────
REQUEST_BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=15000
# drain time on SIGTERM (keep below the ECS stopTimeout)
SHUTDOWN_GRACE_MS=15000

# ── Frontend (FRONTEND-PUBLIC, inlined at build time) ────────────────────────
# Where the browser sends API calls. Production behind one ALB: /api (same origin).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AWS deployment (used by CI/deploy tooling, not by the app) ───────────────
AWS_REGION=<aws-region>
AWS_ACCOUNT_ID=<aws-account-id>
ECR_BACKEND_REPOSITORY=memed-backend
ECR_FRONTEND_REPOSITORY=memed-frontend
ECS_CLUSTER=memed
ECS_BACKEND_SERVICE=memed-backend
ECS_FRONTEND_SERVICE=memed-frontend

# ── Tests only (backend) ─────────────────────────────────────────────────────
# MONGODB_TEST_URI=mongodb://localhost:27017/?replicaSet=rs0   # use an existing replica set instead of an in-memory one
# TEST_REDIS_URL=redis://localhost:6379                         # exercise the real Redis cache/limiter in tests
