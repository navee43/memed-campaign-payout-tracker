{
  "name": "@memed/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Meme'd API — auth, campaigns, submissions and the transactional payout engine",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration",
    "test:concurrency": "jest --runInBand tests/integration/concurrency.test.ts --selectProjects integration",
    "test:watch": "jest --watch",
    "seed": "tsx --env-file-if-exists=../.env src/scripts/seed.ts",
    "db:init": "tsx --env-file-if-exists=../.env src/scripts/init-db.ts",
    "reconcile": "tsx --env-file-if-exists=../.env src/scripts/reconcile.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "db:init:prod": "node dist/scripts/init-db.js",
    "reconcile:prod": "node dist/scripts/reconcile.js",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
